#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters
#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 

#define VOXEL_LST_BIND_ININDEX
#define VOXELLST 1

#include "../bindinglayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../functions.glsl"
#include "../nanovdb_info.glsl"
#include "../shade_state_voxel.glsl"

PtPayload        prd;
ShadowHitPayload shadow_payload;

#include "../traceray_comp.glsl"

layout(local_size_x = GROUP_SIZEX) in;

#define MAXBAND    25
#define NUM_VNIR 2001 
#define NUM_BAND 2002

float GammaR[DIFFUSE_ANGLE_NUM * DIFFUSE_ANGLE_NUM];
float GammaT[DIFFUSE_ANGLE_NUM * DIFFUSE_ANGLE_NUM];



void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    if(bufferId0 >= uint(setting.voxelCount)) return;
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    if(voxelLinks[bufferId0].isValid==0) return;
    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();
    uint instanceId = voxelLinks[bufferId0].instanceId;
    uint meshId = instanceLinks[instanceId].meshId;
    uint typeId = meshLinks[meshId].type;
    uint spectralId = meshLinks[meshId].spectralId;
    uint spectralIdBase = spectralId * NUM_BAND;
    uint canopyId = meshLinks[meshId].canopyId;
    Canopy canopy = canopies[canopyId];
    voxelNetRads[bufferId0].directVrad = 0.0;
    voxelPnets[bufferId0].directPnet = 0.0;

    //---------------------------------------------------
    // Iteration in VNIR band
    //---------------------------------------------------
    float Rin = ubom.meteo.Rin;               // measurement height 
    float Rli = ubom.meteo.Rli;               // wind speed

    vec3 solarDirection = normalize(lightSet.direction);
    float cosSolar = abs(solarDirection.y);
    float alpha_toSolar = voxelDirs[bufferId0].solar;
    int kstep = max(setting.n_jump, 1);
    int step_num = (NUM_VNIR + kstep - 1) / kstep;
    for(int kbandi = 0; kbandi < step_num; kbandi++)
    {
        int kband_start = kbandi * kstep;
        int kband_end = min(kband_start + kstep, NUM_VNIR);
        int kband_center = (kband_start + kband_end - 1) / 2;
        float directFraction = 0.0;
        for(int kband = kband_start; kband < kband_end; kband++)
        {
            directFraction += atomConds[kband].direct * 0.001;
        }
        // solar direct radiance: lightSet.Rin*atomConds[kband].direct*0.001
        // transmittance to solar: alpha_toSolar
        // absorb = 1- refl - trans
        float absorb = 1 - spectralMaterials[spectralIdBase + kband_center].transmittance -
                spectralMaterials[spectralIdBase + kband_center].reflectance;
        if(isParticipatingMedium(canopy)) {
            float voxelTransmittance = canopyVoxelTransmittance(
                canopy, 0.0, 0.0, 1.0, setting.scale);
            absorb = (1.0 - voxelTransmittance)
                * (1.0 - clamp(canopy.scatteringAlbedo, 0.0, 1.0));
        }
        // Sunlit/shaded temperatures are conditional components.  Always
        // solve the sunlit component with unobstructed direct irradiance;
        // voxelDirs.solar is applied later as the moving sunlit fraction.
        // Gating the direct term with alpha_toSolar makes both conditional
        // temperatures shaded exactly under a crown and erases the shadow.
        float sunAboveHorizon = solarDirection.y > 0.01
            ? 1.0 : 0.0;
        float rad = Rin * directFraction * sunAboveHorizon;

        // rad = atomConds[kband].direct * 0.001;
        // rad = spectralMaterials[spectralIdBase + kband].reflectance;
        // vegetation projection correction;
        if(typeId == TYPE_VEGETATION && !isParticipatingMedium(canopy)){
            if (cosSolar > 0.05){ //
                rad = rad / cosSolar;
            }
            else{
                rad = rad / 0.05;
            }
            

            float lai = canopies[canopyId].lai;
            float p = calReCor(lai);
            float refl = spectralMaterials[spectralIdBase + kband_center].reflectance;
            float trans = spectralMaterials[spectralIdBase + kband_center].transmittance;
            float w = refl + trans;
            float s = (w - p* w) / (1 - p* w);
            float a = (1-w) / (1 - p *w); 
            // absorb = a;
            rad = rad * 0.5;
        }


        if(isParticipatingMedium(canopy)) {
            rad = rad / max(cosSolar, 0.05) * alpha_toSolar;
        }
        rad = rad * absorb;
        // rad = cosSolar;
        // save direct VNIR radiance
        //  rad = spectralMaterials[spectralIdBase + kband].reflectance;

        atomicAdd(voxelNetRads[bufferId0].directVrad, rad, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);

        // only for band from 400 nm to 700 nm 
        if((atomConds[kband_center].wavelength>=400) && (atomConds[kband_center].wavelength<=700))
        {
            float pnet = rad * atomConds[kband_center].wavelength * 1e-3 /(AHC);
            atomicAdd(voxelPnets[bufferId0].directPnet, pnet,
                gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
        }
    }

}
