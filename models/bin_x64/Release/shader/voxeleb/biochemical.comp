#version 460
#extension GL_ARB_separate_shader_objects : enable
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_ray_query : enable
#extension GL_ARB_shader_clock : enable                 // Using clockARB
#extension GL_EXT_shader_image_load_formatted : enable  // The folowing extension allow to pass images as function parameters

#extension GL_NV_shader_sm_builtins : require     // Debug - gl_WarpIDNV, gl_SMIDNV
#extension GL_ARB_gpu_shader_int64 : enable       // Debug - heatmap value
#extension GL_EXT_shader_realtime_clock : enable  // Debug - heatmap timing

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_memory_scope_semantics:require
#extension GL_EXT_shader_atomic_float: require 

#define VOXEL_LST_BIND_ININDEX
#define VOXELLST 1

#include "../bindinglayout.h"
#include "../parameters.h"
#include "../global.glsl"
#include "../functions.glsl"
#include "../nanovdb_info.glsl"

layout(local_size_x = GROUP_SIZEX) in;

void main()
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    if(bufferId0 >= uint(setting.voxelCount)) return;
    if(voxelLinks[bufferId0].isValid==0) return;
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    uint instanceId0 = voxelLinks[bufferId0].instanceId;
    // VoxelInstanceLink instanceLink0 = instanceLinks[instanceId0];
    InstanceLink instanceLink0 = instanceLinks[instanceId0];
    MeshLink meshLink0 = meshLinks[instanceLink0.meshId];


    int faceId = voxelLinks[bufferId0].faceId;
    //if(primId0 - faceid0*10 == 0) return; 

    // Carbon-process output shares the existing per-voxel flux buffer.  Set
    // non-vegetation voxels to zero before the vegetation branch below.
    voxelHeatFlux[bufferId0].GPPsunlit = 0.0;
    voxelHeatFlux[bufferId0].GPPshaded = 0.0;
    voxelHeatFlux[bufferId0].NPPsunlit = 0.0;
    voxelHeatFlux[bufferId0].NPPshaded = 0.0;


    // a lot of parameters
    float scale = setting.scale;
    ivec3 semiRange = ivec3(floor(setting.voxelSize.x/2.0 + 0.5),
                            floor(setting.voxelSize.y/2.0 + 0.5),
                            floor(setting.voxelSize.z/2.0 + 0.5));       // voxel scene semiRange.
    uint spectralId,canopyId,typeId,bioId;
    float Type,Vcmax,BallBerrySlope,RdPerVcmax25,BallBerry0,Vcmax25;
    float Tc,eb,O,p;
    float fPAR = 1;
    float effcon;
    float slti,shti,Thl,Thh,Trdm;
    float Tref,Kc25,Ko25,spfy25,Kpep25,atheta,Kf,Kd,Kp,rhoa,Mair,spfy;
    float Rd;
    float stressfactor,Q, hcmax,xl,kV;
    float rss;
    // double ppm2bar,Cs,Ci,Es;
    float ppm2bar,Cs,Ci,Es;
    int Tcor;
    vec3 voxelId;
    Canopy canopy;

    // the property Id for a voxel
    spectralId = meshLink0.spectralId;
    canopyId = meshLink0.canopyId;
    bioId = meshLink0.bioId;
    typeId = meshLink0.type;

    

    if(typeId == TYPE_SOIL)
    {   
        //----------------------
        //        SOIL
        //----------------------
        rss = soilSets[bioId].rss;
        atomicStore(voxelRsss[bufferId0].sunlit, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
		atomicStore(voxelRsss[bufferId0].shaded, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    
    }else if(typeId == TYPE_BUILDING)
    {   
        //----------------------
        //        BUILDING
        //----------------------
        rss = soilSets[bioId].rss;
        atomicStore(voxelRsss[bufferId0].sunlit, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
		atomicStore(voxelRsss[bufferId0].shaded, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    
    }
    else if(typeId == TYPE_WATER)
    {
        rss = max(waterSets[bioId].rss, 0.0);
        atomicStore(voxelRsss[bufferId0].sunlit, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
        atomicStore(voxelRsss[bufferId0].shaded, rss, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    }
    
    
    else if(typeId == TYPE_VEGETATION)
    {
        //---------------------
        //     vegetation 
        //---------------------
        vec3 voxelPos = vec3(voxelId0.x +0.5 -semiRange.x,
                             voxelId0.y +0.5,
                             voxelId0.z +0.5 -semiRange.z); 

        // canopy property
        // the maximal height not only for this voxel
        canopy = canopies[canopyId];
        if(isParticipatingMedium(canopy)) return;
        hcmax = canopy.height;
        // xl: a proportion from top to bottom i.e.,[0,-1]
        xl = hcmax > 0.0 ? -(hcmax - voxelPos.y*scale)/hcmax : 0.0;
        xl = clamp(xl,-1,0);
        // issunlit = 0 for shaded, issunlit = 1 for sunlit




        for(int issunlit=0; issunlit<2; issunlit++)
        {
            //---------------------------------------------
            //  Input from CPU parameters
            //---------------------------------------------
            //////// environmental parameter
            if (issunlit == 0) {
                Tc = voxelTempes[bufferId0].shaded;
            } else {
                Tc = voxelTempes[bufferId0].sunlit;
            }
            if(Tc < 100.0) Tc += 273.15;
            // Cs: carbon dioxide (CO2) concentration on leaf surface
            Cs = voxelAirs[bufferId0].cs;
            // Es: Water (H2O) concentration on leaf surface
            Es = voxelAirs[bufferId0].es;
            //  net radiation, PAR
            Q = voxelPnets[bufferId0].diffusePnet;
            if (issunlit == 1) {
                Q += voxelPnets[bufferId0].directPnet;
            }
            // intial estimate of the vapour pressure in leaf boundary layer
            eb = ubom.meteo.ea;
            // concentration of O2 
            O = ubom.meteo.Oa;
            //  air pressure
            p = ubom.meteo.p;
            //////// Biochemical parameter
            // C3 and C4
            Type = leafBios[bioId].Type;
            // maximum carboxylation capacity at 25 C
            Vcmax25 = leafBios[bioId].Vcmax;
            // Ball-Berry coefficient 'm' for stomatal regulation
            BallBerrySlope = leafBios[bioId].leafM;
            // respiration as fraction of Vcmax25
            RdPerVcmax25 = leafBios[bioId].Rdparam;
            kV = leafBios[bioId].kV;
            // temperature correction to Vcmax has to be applied.
            Tcor = leafBios[bioId].Tcor;
            // stress factor to reduce Vcmax 
            stressfactor = leafBios[bioId].stressfactor;
            // (OPTIONAL) Ball-Berry intercept term 'b' 
            BallBerry0 = 0.01;
            // due to vertical distribution 
            Vcmax25 = Vcmax25 * exp(kV * xl);
            //number of CO2 per electrons - typically 1/5 for C3 and 1/6 for C4
            if(Type <= 3.5) {effcon = 1.0/5;}
            else {effcon = 1.0/6;}
            // vector of 5 temperature correction parameters
            slti = leafBios[bioId].Tparam[0];
            shti = leafBios[bioId].Tparam[1];
            Thl  = leafBios[bioId].Tparam[2];
            Thh  = leafBios[bioId].Tparam[3];
            Trdm = leafBios[bioId].Tparam[4];

            bool inputValid = biochemicalFinite(Tc) && Tc > 0.0 &&
                biochemicalFinite(Cs) && Cs >= 0.0 && biochemicalFinite(eb) && eb >= 0.0 &&
                biochemicalFinite(O) && O >= 0.0 && biochemicalFinite(p) && p > 0.0 &&
                biochemicalFinite(p * 100.0) &&
                biochemicalFinite(voxelPnets[bufferId0].directPnet) && voxelPnets[bufferId0].directPnet >= 0.0 &&
                biochemicalFinite(voxelPnets[bufferId0].diffusePnet) && voxelPnets[bufferId0].diffusePnet >= 0.0 &&
                biochemicalFinite(Q) && Q >= 0.0 && (Type == 3.0 || Type == 4.0) &&
                biochemicalFinite(Vcmax25) && Vcmax25 >= 0.0 &&
                biochemicalFinite(BallBerrySlope) && BallBerrySlope >= 0.0 &&
                biochemicalFinite(RdPerVcmax25) && RdPerVcmax25 >= 0.0 &&
                biochemicalFinite(kV) && kV >= 0.0 &&
                biochemicalFinite(stressfactor) && stressfactor >= 0.0 && stressfactor <= 1.0 &&
                biochemicalFinite(hcmax) && hcmax > 0.0 && (Tcor == 0 || Tcor == 1) &&
                biochemicalFinite(slti) && slti >= 0.0 && biochemicalFinite(shti) && shti >= 0.0 &&
                biochemicalFinite(Thl) && Thl > 0.0 && biochemicalFinite(Thh) && Thh > Thl &&
                biochemicalFinite(Trdm) && Trdm > 0.0;
            if(!inputValid)
            {
                float missing = biochemicalMissing();
                if(issunlit == 0)
                {
                    voxelHeatFlux[bufferId0].GPPshaded = missing;
                    voxelHeatFlux[bufferId0].NPPshaded = missing;
                    voxelRsss[bufferId0].shaded = missing;
                }
                else
                {
                    voxelHeatFlux[bufferId0].GPPsunlit = missing;
                    voxelHeatFlux[bufferId0].NPPsunlit = missing;
                    voxelRsss[bufferId0].sunlit = missing;
                }
                voxelAirs[bufferId0].ci = missing;
                continue;
            }


            //-------------------------------------
            // Input using constant parameters at optimum temperature
            //-------------------------------------
            Tref = 25 + 273.15; // absolute temperature at 25 oC
            Kc25 = 350;         // kinetic coefficient (Km) for CO2
            Ko25 = 450;         // kinetic coeeficient (Km) for  O2
            spfy25 = 2600;      // specificity
            Kpep25 = (Vcmax25/56)*1e6; //  (C4) PEPcase rate constant for CO2, used here: Collatz et al: Vcmax25 = 39 umol m-1 s-1; kp = 0.7 mol m-1 s-1.
            atheta = 0.8;

            //  electron transport and fluorescence
            Kf = 0.05;         //  rate constant for fluorescence
            Kd = max(0.8738, 0.0301 *(Tc-273.15)+0.0773); //  rate constant for thermal deactivation at Fm
            Kp = 4.0;        // rate constant for photochemisty
            rhoa = 1.2047;   // specific mass of air
            Mair = 28.96;    // molecular mass of dry air

            // convert all to bar: CO2 was supplied in ppm, O2 in permil, and pressure in mBar
            ppm2bar = 1E-6 * (p * 1E-3);


// float a = float(int(ppm2bar * Cs * 1E9 + 0.00001));
// highp float a = int(p * Cs) * 0.1;
// atomicStore(voxelRsss[bufferId0].sunlit, a, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
// return;
            Cs  = Cs * ppm2bar;

            O   = (O * 1E-3) * (p * 1E-3);
            if(Type > 3.5) O = 0;
            Kc25 = Kc25 * 1e-6;
            Ko25 = Ko25 * 1e-3;

            // temperature corrections
            float qt,TH,TL; 
            qt = 0.1*(Tc-Tref)*Tcor;  // tempcorr = 0 or 1: this line dis/enables all Q10 operations
            TH = 1 + Tcor * exp(shti *(Tc-Thh));
            TL = 1 + Tcor* exp(slti * (Thl -Tc));

            float QTVc,Kc,Ko,Kpepcase,po0;
            QTVc = 2.1;       // Q10 base for Vcmax and Kc
            Kc = Kc25 * exp(log(2.1)*qt);
            Ko = Ko25 * exp(log(1.2)*qt);
            Kpepcase = Kpep25 * exp(log(1.8)*qt); // "pseudo first order rate constant for PEP carboxylase WRT pi



            // jak 2014-12-04: Add TL for C3 as well, works much better with our cotton temperature dataset (A-T)
            if(Type < 3.5){
                Vcmax = Vcmax25 * exp(log(QTVc)*qt)/TH*stressfactor;
            }else if(Type > 3.5){
                Vcmax = Vcmax25 * exp(log(QTVc)*qt)/(TH*TL) * stressfactor;
            }

            // specificity (tau in Collatz e.a. 1991)
            spfy = spfy25 * exp(log(0.75)*qt);
            // "Dark" Respiration
            Rd  =  RdPerVcmax25 * Vcmax25 * exp(log(1.8)*qt) / (1+ exp(1.3*(Tc-Trdm)));
            // calculation of potential electron transport rate
            po0 = Kp / (Kf+Kd + Kp);
            float Je,Gamma_star,MM_const,Vs_C3,minCi;
            // Q is absorbed PAR in umol photons m^-2 leaf s^-1.
            Je = 0.5 * po0 * Q * fPAR;

            //  voxelRsss[bufferId0].sunlit = float(po0);
            // voxelRsss[bufferId0].shaded = float(Q);
            //  return;


            //  calculation of the intersection of enzyme and light limited curves
            Gamma_star = 0.5 * O / spfy; // compensation point in absence of Rd
            if(Type < 3.5){
                MM_const = (Kc *(1+O/Ko));
                Vs_C3 = (Vcmax25/2) * exp(log(1.8)*qt); 
                minCi = 0.3;
            }else if(Type > 3.5){
                MM_const = 0;
                Vs_C3 = 0; 
                minCi = 0.1;
            }

            // voxelRsss[bufferId0].shaded = Type;
            // return;

            //-------------------------------
            // Calculation of Ci: BallBerry only for case with b = 0
            //-------------------------------
            float RH,Ci;
            RH = clamp(eb/es_fun(Tc-273.15), 0.0, 1.0);
            //% EXPLANATION:   *at equilibrium* CO2_in = CO2_out => A = gs(Cs - Ci) [1]
            //%  so Ci = Cs - A/gs (at equilibrium)                                 [2]
            //%  Ball-Berry suggest: gs = m (A RH)/Cs + b   (also at equilib., see Leuning 1990)
            // %  if b = 0 we can rearrange B-B for the second term in [2]:  A/gs = Cs/(m RH)
            //%  Substituting into [2]
            //%  Ci = Cs - Cs/(m RH) = Cs ( 1- 1/(m RH)  [ the 1.6 converts from CO2- to H2O-diffusion ]
            Ci = biochemicalIntercellularCO2(Cs, minCi * Cs, BallBerrySlope, RH, 1.0);


            //------------------------------
            // Caluculation of A: ComputeA
            //-----------------------------
            //float A = computeA(float(Ci),int(Type),float(1.0),Vs_C3,MM_const,Rd,Vcmax,Gamma_star,Je,effcon,atheta,Kpepcase);
            float Vc,Ve,Vs,CO2_per_electron;
            if(Type < 3.5)
            {
                Vs = Vs_C3;
                Vc = MM_const + Ci > 0.0 ? Vcmax *(Ci-Gamma_star)/(MM_const + Ci) : 0.0;
                CO2_per_electron = Ci+2*Gamma_star > 0.0 ? (Ci-Gamma_star)/(Ci+2*Gamma_star) * effcon : 0.0;
                Ve = Je * CO2_per_electron;
            }else if(Type > 3.5)
            {
                Vc = Vcmax;
                Vs =  Kpepcase * Ci;
                CO2_per_electron = effcon;
                Ve = Je * CO2_per_electron;
            }
            
            float V = biochemicalQuadraticRoot(atheta, -(Vc+Ve), Vc*Ve, sign(-Vc));
            float Ag = biochemicalQuadraticRoot(0.98,-(V+Vs),V*Vs, -1.0);
            if(Q == 0.0 || Cs == 0.0 || BallBerrySlope == 0.0 || RH == 0.0 || stressfactor == 0.0)
                Ag = 0.0;
            float A = Ag - Rd;
            float rcw = biochemicalResistance(Cs, Ci, A, rhoa, Mair, p * 100.0);
            float ciPpm = Ci / ppm2bar;
            bool ratesValid = biochemicalFinite(Vcmax) && Vcmax >= 0.0 &&
                biochemicalFinite(ppm2bar) && ppm2bar > 0.0 &&
                biochemicalFinite(TH) && TH > 0.0 && biochemicalFinite(TL) && TL > 0.0 &&
                biochemicalFinite(Kc) && Kc > 0.0 && biochemicalFinite(Ko) && Ko > 0.0 &&
                biochemicalFinite(Kpepcase) && Kpepcase >= 0.0 &&
                biochemicalFinite(spfy) && spfy > 0.0 && biochemicalFinite(po0) &&
                biochemicalFinite(Je) && Je >= 0.0 && biochemicalFinite(V) &&
                biochemicalFinite(Vc) && biochemicalFinite(Ve) && biochemicalFinite(Vs);
            bool resultValid = ratesValid && biochemicalFinite(Ag) && biochemicalFinite(A) &&
                biochemicalFinite(Rd) && biochemicalFinite(RH) && biochemicalFinite(Ci) &&
                biochemicalFinite(ciPpm) && ciPpm >= 0.0 &&
                biochemicalFinite(rcw) && rcw >= 0.0;
            if(!resultValid)
            {
                Ag = biochemicalMissing();
                A = biochemicalMissing();
                Ci = biochemicalMissing();
                ciPpm = biochemicalMissing();
                rcw = biochemicalMissing();
            }
            if(issunlit == 0) {
                voxelHeatFlux[bufferId0].GPPshaded = resultValid ? max(0.0, Ag) : biochemicalMissing();
                voxelHeatFlux[bufferId0].NPPshaded = A;
            } else {
                voxelHeatFlux[bufferId0].GPPsunlit = resultValid ? max(0.0, Ag) : biochemicalMissing();
                voxelHeatFlux[bufferId0].NPPsunlit = A;
            }
            // stomatal conductance (gs)
            // tomatal resistance (rcw)
// float a = float(Cs);
// atomicStore(voxelRsss[bufferId0].sunlit, a, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
// return;

            // save back 
            if(issunlit==0) voxelRsss[bufferId0].shaded = rcw;
            else voxelRsss[bufferId0].sunlit = rcw;
            voxelAirs[bufferId0].ci = ciPpm;

            
        }// if issunlit or not

    }// if vegetation


}
