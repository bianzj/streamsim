// To check if this can be to solar 
bool TraversalDirection(vec3 lightDirection)
{
    //------------------------------------------------------------
    // Initialization for the position and SSBO index
    //------------------------------------------------------------
    // get bufferId, voxelId, instanceId and typeId
    uint bufferId0 = uint(gl_GlobalInvocationID.x);
    ivec3 voxelId0 = voxelLinks[bufferId0].voxelId;
    uint instanceId0 = voxelLinks[bufferId0].instanceId;
    uint meshId0 = instanceLinks[instanceId0].meshId;
    uint typeId0 = meshLinks[meshId0].type;

    float temp = 0;
    atomicAdd(voxelDirs[bufferId0].solar, temp, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    int faceId = voxelLinks[bufferId0].faceId;

    //if(primId0 - faceid0*10 == 0) return true; 

    // Get nanoVDBLink: from voxelId to bufferId
    NanoVDBLink nanoVDBLink = nanovdbInit();
  

    // get center position of a voxel
    float scale = setting.scale;
    float density=1.0;
    float G=0.5;
    vec3 semiRange = vec3(floor(setting.voxelSize.x/2.0+0.5),0,floor(setting.voxelSize.z/2.0+0.5));
    // from 0 - 100  to -50 - 50 scale
    // from 0-9 to -5 - 4
    vec3 voxelPos0 = vec3(voxelId0.x - semiRange.x,
                          voxelId0.y,
                          voxelId0.z -semiRange.z); 

    if(typeId0 == TYPE_BUILDING)
    {
       getFacetIdPos(faceId,  voxelPos0);
    }

    ivec3 voxelId, alignVoxelId;                      // current passed voxel
    int bufferId,meshId,alignBufferId;                       // passed voxel Id
    uint instanceId, canopyId, typeId;  //passed voxel Id through voxelLink and instanceLink.
    ivec3 voxelRes = ivec3(setting.voxelSize);
    float alpha_toSolar = 1.0;
    float alpha_voxel = 1.0;
    
    // ray cast from the center position of a voxel along a specific direction
    Ray ray = Ray(voxelPos0, lightDirection);

    // This is a process toward direction step by step
    int kstep = 0;
    vec3 ffnormal;
    for(kstep = 0; kstep<setting.maxStep; kstep++)
    {
        // the transmittance inside a voxel
        alpha_voxel = 1.0;
        ClosestHit(ray,0.01);
        // hit nothing and return false.
        if(prd.hitT == INFINITY)
        {
            voxelDirs[bufferId0].solar = alpha_toSolar;
            return false;
        }
        // get hit information, especially get ffnormal to avoid hit self.
        ShadeState sstate = GetShadeState(prd);
        voxelId = getVoxelIdSemi(sstate.position,semiRange,setting.scale,normalize(lightDirection),alignVoxelId);
        //--------------------------------
        // The passing vegetation voxel
        //--------------------------------
        bufferId = nanovdbGet(nanoVDBLink, voxelId);
        // a valid voxel and get this voxel information.
        if(bufferId >= 0){
            instanceId = voxelLinks[bufferId].instanceId;
            meshId = instanceLinks[instanceId].meshId;
            typeId = meshLinks[meshId].type;
            canopyId = meshLinks[meshId].canopyId;
            if(abs(float(typeId - TYPE_VEGETATION))<0.1){
                G = canopies[canopyId].G;
                // density determined by mesh/isntance or pixel scale?
                if(setting.islad < 1){
                    density = canopies[canopyId].density;
                }else{         
                    uint surf1DId = SurfFlatten(voxelId, voxelRes);
                    density = lads[surf1DId]; 
                }
                float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);
                 alpha_voxel = exp(-density * G * pathLength * scale);
            }   
        }
        //--------------------------------
        // The next soil/building voxel
        //--------------------------------
        alignBufferId = nanovdbGet(nanoVDBLink, alignVoxelId);
        if (alignBufferId >=0){
            if (alpha_toSolar <= 0.001) break;
            instanceId = voxelLinks[alignBufferId].instanceId;
            meshId = instanceLinks[instanceId].meshId;
            typeId = meshLinks[meshId].type;

            if ((abs(float(typeId - TYPE_SOIL)) < 0.1) || (abs(float(typeId - TYPE_BUILDING)) < 0.1)){
                alpha_toSolar = 0.0;
                break;
            }
        }
        alpha_toSolar = alpha_toSolar * alpha_voxel;
        if(alpha_toSolar <= 0.001) break;
        // avoid hit self.
        ffnormal  = sstate.normal;
        ray.origin = OffsetRay(sstate.position, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
    }
    atomicAdd(voxelDirs[bufferId0].solar, alpha_toSolar, gl_ScopeDevice,gl_StorageSemanticsBuffer,gl_SemanticsRelaxed);
    return true;
}

void main()
{
  // solar direction
  vec3 directions = normalize(lightSet.direction);
  uint bufferId0 = uint(gl_GlobalInvocationID.x);
  if(voxelLinks[bufferId0].isValid==0) return;
  if(directions.y < 0.01) {
    // ts = 0 if solar direction is down
    voxelDirs[bufferId0].solar = 0.0;
  }else{
    TraversalDirection(directions);
  }
}
