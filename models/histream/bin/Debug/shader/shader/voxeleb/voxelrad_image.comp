#define MAXBAND    25
#define NUM_VNIR 2001
#define NUM_BAND 2002

float wavelength = 10500;
float LST;
float LSTSum;

bool Voxel_raytracing(Ray ray, NanoVDBLink nanoVDBLink)
{
    // initialized the transmittance and accumulated radiance 
    float alpha_toSensor = 1.0;
    float alpha_toSolar, alpha_voxel;
    float density,G,lai;
    LST = 0.0;
    vec3 ffnormal;
    ivec3 voxelId;
    int bufferId,alignBufferId;
    float scale = setting.scale;			// scale
    uint instanceId, typeId,meshId;                // passed voxel Id through voxelLink and instanceLink.
    uint canopyId, thermalId, spectralId;   // passed voxel spectral, thermal, canopy ID.
	float pl_toSolar, pl_toSensor;			// hotspot parameters.
    Canopy canopy;							// store canopy information
    vec3 semiRange = vec3(floor(setting.voxelSize.x/2.0+0.5),0,floor(setting.voxelSize.z/2.0+0.5));
    
    
    vec2 gamma = scattering_phase_function_direct_XZY_paper(normalize(lightSet.direction), normalize(-sensorMatrix.direction));
    vec2 gammaMax = scattering_phase_function_direct_XZY_paper(normalize(lightSet.direction), normalize(-lightSet.direction));
    float gammaValue = (gamma.x) * 1.0 + (gamma.y) * 0.5;
    float gammaMaxValue = (gammaMax.x) * 1.0 + (gammaMax.y) * 0.5;
    float phase = gammaValue / gammaMaxValue;
    phase = clamp(phase,0,1);
    ivec3 voxelRes = ivec3(setting.voxelSize);

    float canopyTSum = 0.0;
    float canopyTNum = 0;
    

    float vegTemperatureSum = 0;
    float vegNum = 0;
    for(int kstep = 0;kstep<=setting.maxStep;kstep++)
    {
        alpha_voxel = 1.0;
        ClosestHit(ray, 0.001);

        ///////////////////////////////////////////////////
		/// sky case (sky -> sensor).
		/// hit sky or out of scene, then return true. 
		/// the sky contribution is added in solar file.
		///////////////////////////////////////////////////
        if(prd.hitT == INFINITY)
        {
            LST += 0;
            return true;
        }

        ///////////////////////////////////////////////////
		/// Turbid or facet ground case (j -> sensor).
		///////////////////////////////////////////////////
		/// get hit information.
		ShadeState sstate = GetShadeState(prd);
		//voxelId = getPassedVoxelId(sstate.position, scale, normalize(ray.direction));
        ivec3 alignVoxelId;
        voxelId = getVoxelIdSemi(sstate.position,semiRange,setting.scale,normalize(ray.direction),alignVoxelId);
		bufferId = nanovdbGet(nanoVDBLink, voxelId);
        alignBufferId = nanovdbGet(nanoVDBLink, alignVoxelId);


        // LST = sstate.position.y;
        // LST = bufferId;
        // LST = alignBufferId;
        // LST = alignVoxelId.y;
        // LST = 20;
        // return false;
        
   
        if(bufferId >= 0)
		{
            
			instanceId = voxelLinks[bufferId].instanceId;
            meshId = instanceLinks[instanceId].meshId;

			typeId = meshLinks[meshId].type;
			canopyId = meshLinks[meshId].canopyId;
			spectralId = meshLinks[meshId].spectralId;
			thermalId = meshLinks[meshId].thermalId;

			canopy = canopies[canopyId];
            uint spectralBase = spectralId * NUM_BAND;
            float envTemp = Inv_Stefen_Boltzmann(voxelNetRads[bufferId].diffuseTrad, 1);

            // LST = voxelNetRads[bufferId].diffuseVrad;
            // LST = voxelHeatFlux[bufferId].Gshaded;
            // LST = voxelDirs[bufferId].solar;
            // LST = voxelTempes[bufferId].sunlit;
            // LST = voxelDirs[bufferId].solar;
            // return true;
            // LST = voxelDirs[bufferId].solar;
            // LST = voxelHeatFlux[bufferId].Gsunlit;
            // LST =  voxelRsss[bufferId].sunlit;
            // LST = alpha_toSensor;
            // return true;


			if(typeId == TYPE_VEGETATION)
			{
                // LST = voxelDirs[bufferId].solar;
                // return true;

                G = canopies[canopyId].G;
                lai = canopies[canopyId].lai;
                // density determined by mesh/isntance or pixel scale?
                if(setting.islad < 1){
                    density = canopies[canopyId].density;
                }else{         
                    uint surf1DId = SurfFlatten(voxelId, voxelRes);
                    density = lads[surf1DId]; 
                }
				float pathLength = Vector2Distance(sstate.position - sstate.lastPosition);// * 0.2; //!!!!需要改回去！！！
                alpha_voxel = exp(-density * G * pathLength * scale);
				alpha_toSolar = voxelDirs[bufferId].solar;

                // LST = pathLength;
                // return true;
                // float sunlitTemperature1 = voxelTempes[bufferId].sunlit;
                // LST =  Planck(wavelength, sunlitTemperature1);
                // // // LST = voxelNetRads[bufferId].diffuseVrad;// + voxelNetRads[bufferId].diffuseTrad;
                // LST =  voxelNetRads[bufferId].directVrad;
                // // // // // LST = voxelRsss[bufferId].sunlit;
                // // // // // LST = voxelRaas[bufferId].raa;
                // // // // // // // // // LST = sunlitTemperature1;
                // // // // LST = voxelNetRads[bufferId].diffuseTrad;
                // return true;
                
				if(alpha_toSensor < 0.001) {
                    
                    break;
                }
				// this is used for the hotspot effect
				if(alpha_toSolar < 0.0001) pl_toSolar = 10000.0;
				else pl_toSolar = -log(alpha_toSolar) / G / DENSITY;
				if(alpha_toSensor < 0.0001) pl_toSensor = 10000.0;
				else pl_toSensor = -log(alpha_toSensor) / G / DENSITY;
                float hspot = canopy.hspot;
				float hotspot = Hotspot_Kuusk(normalize(lightSet.direction), normalize(sensorMatrix.direction), pl_toSolar, pl_toSensor, DENSITY, hspot);
                if (checkSameDirection(normalize(lightSet.direction), normalize(sensorMatrix.direction)) && abs(alpha_toSolar - alpha_toSensor) < EPSION_2)
                {
                    alpha_toSolar = alpha_toSensor;
                    hotspot = alpha_toSensor;
                }
                if ((pl_toSensor > 999) || (pl_toSolar>999))
                {
                    hotspot = 0.0;
                }

                float alpha_ = alpha_toSensor;
                if (kstep==1){
                    alpha_ = min(alpha_toSolar, alpha_toSensor);
                }
                float fhotspot = hotspot / alpha_ * phase;

                // float fhotspot = hotspot / alpha_toSensor * phase;

                if (fhotspot > 1) fhotspot = 1.0;
                if (fhotspot < 0.0) fhotspot = 0.0;

                float refl = spectralMaterials[spectralBase + NUM_VNIR].reflectance;
                float trans = spectralMaterials[spectralBase + NUM_VNIR].transmittance;

                
                // get sunlit and shaded fraction and mixed them for an average result.
                float sunlitTemperature = voxelTempes[bufferId].sunlit;
                float shadedTemperature = voxelTempes[bufferId].shaded;

                // hot spot
                float radianceDirect = 0.0;
                float thermalRadiance = Planck(wavelength, sunlitTemperature) * fhotspot * alpha_toSensor
                                    + Planck(wavelength, shadedTemperature) * (alpha_toSensor * (1 - fhotspot));


                // self collipsion;
                float p = calReCor(lai);
                float w = refl + trans;
                float s = (w - p* w) / (1 - p* w);
                float a = (1-w) / (1 - p *w); 
                // radianceDirect = thermalRadiance * (1 - refl - trans) * (1 - alpha_voxel);
                radianceDirect = thermalRadiance * (a) * (1 - alpha_voxel);
                                
                // LST += radianceDirect; // debug
                if (radianceDirect > 0){
                    LST += radianceDirect;
                }

                // LST += Planck(wavelength, envTemp) * (1 - alpha_voxel) * (refl) * alpha_toSensor;
                LST += Planck(wavelength, envTemp) * (1 - alpha_voxel) * (s) * alpha_toSensor;


				alpha_toSensor = alpha_toSensor * alpha_voxel;

                vegTemperatureSum += shadedTemperature;
                vegNum ++;
			}

		}

        if(alignBufferId >= 0)
		{
            instanceId = voxelLinks[alignBufferId].instanceId;
            meshId = instanceLinks[instanceId].meshId;
            typeId = meshLinks[meshId].type;
            canopyId = meshLinks[meshId].canopyId;
            spectralId = meshLinks[meshId].spectralId;
            thermalId = meshLinks[meshId].thermalId;
            uint bioId = meshLinks[meshId].bioId;
            uint spectralBase = spectralId * NUM_BAND;
            float envTemp = Inv_Stefen_Boltzmann(voxelNetRads[alignBufferId].diffuseTrad, 1);

            // LST = voxelNetRads[alignBufferId].diffuseTrad + voxelNetRads[alignBufferId].directTrad + voxelNetRads[alignBufferId].directVrad + voxelNetRads[alignBufferId].diffuseVrad;
            // float sunlitTemperature1 = voxelTempes[alignBufferId].sunlit;
            // LST =  Planck(wavelength, sunlitTemperature1);
            // // LST = voxelHeatFlux[alignBufferId].Hshaded;
            // // LST = voxelHeatFlux[alignBufferId].LEshaded;
            // // LST = voxelDirs[alignBufferId].solar;
            // // LST = voxelRaas[alignBufferId].raa;
            // // LST = voxelRsss[alignBufferId].shaded;
            // return true;

            if((typeId == TYPE_BUILDING) || (typeId == TYPE_SOIL) || (typeId == TYPE_WATER)){

// if (vegNum==0) vegNum=1;
// LST = vegTemperatureSum/vegNum;//voxelNetRads[bufferId].diffuseTrad;;
// return true;
            
                int faceId = 0;
                if(typeId == TYPE_BUILDING)
                {
                    faceId  = getFaceIdSimple(sstate.position,semiRange,alignVoxelId);
                    alignBufferId = alignBufferId + faceId;
                    // LST = faceId;
                    // return true;
                }
                // LST = voxelHeatFlux[bufferId].Gshaded;
                // return true;
                // LST = 0;
                // return true;

                // LST = voxelNetRads[alignBufferId].directVrad;
                // LST = voxelNetRads[bufferId].diffuseVrad;
                // // LST = voxelNetRads[bufferId].directTrad;
                // // LST = voxelNetRads[bufferId].diffuseTrad;
                // // LST = voxelHeatFlux[bufferId].Gshaded;
                // // LST = voxelDirs[bufferId].solar;
                // // LST = voxelTempes[bufferId].shaded;
                // // LST = voxelRaas[bufferId].raa;
                // // LST = voxelHeatFlux[bufferId].Gsunlit;
                // // break;
                // float sunlitTemperature1 = voxelTempes[alignBufferId].shaded;
                // LST =  Planck(wavelength, sunlitTemperature1);
                // // LST = sunlitTemperature1;
                // return true;
                


				alpha_toSolar = voxelDirs[alignBufferId].solar;

				// this is used for the hotspot effect
				if(alpha_toSolar < 0.0001) pl_toSolar = 10000.0;
				else pl_toSolar = -log(alpha_toSolar) / LEAFG / DENSITY;
				if(alpha_toSensor < 0.0001) pl_toSensor = 10000.0;
				else pl_toSensor = -log(alpha_toSensor) / LEAFG / DENSITY;

                float flag = 0;
				float hotspot =  Hotspot_Kuusk(normalize(lightSet.direction), normalize(sensorMatrix.direction), pl_toSolar, pl_toSensor, DENSITY, HSPOT);
                if (checkSameDirection(normalize(lightSet.direction), normalize(sensorMatrix.direction)) && abs(alpha_toSolar - alpha_toSensor) < EPSION_2)
                {
                    alpha_toSolar = alpha_toSensor;
                    hotspot = alpha_toSensor;
                    flag = 1;
                }
                if ((pl_toSensor > 999) || (pl_toSolar>999))
                {
                    hotspot = 0.0;
                    flag = 2;
                }
                // float alpha_ = min(alpha_toSolar, alpha_toSensor);
                // float fhotspot = hotspot / alpha_ ;

                float refl = spectralMaterials[spectralBase + NUM_VNIR].reflectance;
                float trans = spectralMaterials[spectralBase + NUM_VNIR].transmittance;

                // LST = voxelNetRads[alignBufferId].diffuseTrad + voxelNetRads[alignBufferId].directTrad 
                //                         + voxelNetRads[alignBufferId].directVrad + voxelNetRads[alignBufferId].diffuseVrad - Stefen_Boltzmann(voxelTempes[alignBufferId].sunlit,(1 - refl - trans));
                // // LST = voxelNetRads[alignBufferId].directVrad;
                // return true;

                //// solar and emitted case
                //// (solar -> i -> o) + self-emitter(i -> o); i is soil.
                float radianceDirect = 0.0;
                // get sunlit and shaded fraction and mixed them for an average result.
                float sunlitTemperature = voxelTempes[alignBufferId].sunlit;
                float shadedTemperature = voxelTempes[alignBufferId].shaded;

                // hotspot
                float thermalRadiance = Planck(wavelength, sunlitTemperature) * hotspot 
                                        + Planck(wavelength, shadedTemperature) * (alpha_toSensor - hotspot);
                // float thermalRadiance = Planck(wavelength, sunlitTemperature) * fhotspot *  alpha_toSensor
                //                         + Planck(wavelength, shadedTemperature) * (alpha_toSensor * (1 - fhotspot));

// // soil thermal inertial
// int bioId = meshLinks[meshId].bioId;
// float cs = soilSets[bioId].cs;
// float rhos = soilSets[bioId].rhos;
// float lamb = soilSets[bioId].lambdas ;
// float GAM = thermal_inertial(cs,rhos,lamb);
// LST = shadedTemperature;
// // LST = voxelRaas[alignBufferId].raa;
// break;

                radianceDirect = thermalRadiance * (1 - refl - trans);
                
                //LST = canopy.G;
                if (radianceDirect > 0){
                    LST += radianceDirect;
                }
                
                float surfaceWeight = surfaceReflectanceWeight(
                    typeId, bioId, refl, lightSet.direction,
                    ray.direction, sstate.normal);
                LST += Planck(wavelength, envTemp) * surfaceWeight * alpha_toSensor;

               
				break;
            }
			
		}

        // LST = 55;
        // break;
		//// change ray origin position to hit position; and avoid self collide.
		ray = Ray(sstate.position, ray.direction);
		ffnormal = sstate.normal;
		ray.origin = OffsetRay(ray.origin, dot(ray.direction, ffnormal) > 0 ? ffnormal : -ffnormal);
    }
}

void SamplePixel(vec2 imageCoords,vec2 sizeImage,int smpl)
{
    LST = 0.0;
    // 每次光线的随机/波动进行光滑
    vec2 subpixel_jitter = smpl == 0 ? vec2(0.5f, 0.5f) : vec2(rand(prd.seed), rand(prd.seed));
    // vec2 subpixel_jitter = vec2(0.5f, 0.5f) ;
	// 计算样本的波动，范围 [-1 .. 1]
	const vec2 pixelCenter = vec2(imageCoords) + subpixel_jitter;
	const vec2 inUV        = pixelCenter / vec2(sizeImage.xy);
	vec2       d           = inUV * 2.0 - 1.0;

	// 计算光线的初始化和方向
	vec4 origin    = sensorMatrix.viewInverse * vec4(0, 0, 0, 1);
	vec4 target    = sensorMatrix.projInverse * vec4(d.x, d.y, 1, 1);
	vec4 direction = sensorMatrix.viewInverse * vec4(normalize(target.xyz), 0);

	// // 景深-平行投影还是中心投影
	// vec3  focalPoint        = sensorMatrix.focalDist * direction.xyz;
	// float cam_r1            = rand(prd.seed) * M_TWO_PI;
	// float cam_r2            = rand(prd.seed) * sensorMatrix.aperture;
	// vec4  cam_right         = sensorMatrix.viewInverse * vec4(1, 0, 0, 0);
	// vec4  cam_up            = sensorMatrix.viewInverse * vec4(0, 1, 0, 0);
	// vec3  randomAperturePos = (cos(cam_r1) * cam_right.xyz + sin(cam_r1) * cam_up.xyz) * sqrt(cam_r2);
	// vec3  finalRayDir       = normalize(focalPoint - randomAperturePos);
    NanoVDBLink nanoVDBLink = nanovdbInit();

    // 光线位置和方向
	//Ray ray = Ray(origin.xyz + randomAperturePos, finalRayDir);
    vec3 directionv = normalize(direction.xyz);
	Ray ray = Ray(origin.xyz, directionv);

    Voxel_raytracing(ray, nanoVDBLink);
   // LST = 1.0;
}


void main()
{
    // image imageSize
	ivec2 imageRes    = ivec2(setting.imageSize);
    // image coordinate from 1-imageSize
    ivec2 imageCoords = ivec2(gl_GlobalInvocationID.xy);  //SampleSizzled();
    
    uint temp = uint(setting.imageSize.x * gl_GlobalInvocationID.y + gl_GlobalInvocationID.x);
    prd.seed = tea(temp, setting.frame * setting.n_sample);
    LSTSum = 0.0;

    // int bufferId = int((imageCoords.y * imageRes.x + imageCoords.x ));
    // LST = imageCoords.x;
    // atomicStore(outImage[bufferId], LST, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);


    for(int smpl = 0; smpl< setting.n_sample; smpl++)
    {
        SamplePixel(imageCoords, imageRes, smpl);
        LSTSum += LST;
    }
    LST = LSTSum/setting.n_sample;
    
    int bufferId = int((imageCoords.y * imageRes.x + imageCoords.x ));

    atomicStore(outImage[bufferId], LST, gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease);

}
